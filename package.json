{
  "name": "discord-bot",
  "author": "https://github.com/CuteNikki",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CuteNikki/discord-bot.git"
  },
  "module": "./src/index.ts",
  "dependencies": {
    "@translate-tools/core": "^2.1.0",
    "canvacord": "^6.0.4",
    "cron": "^4.4.0",
    "dayjs": "^1.11.23",
    "discord-actions": "^2.3.13",
    "discord-html-transcripts": "^3.3.0",
    "discord-hybrid-sharding": "^3.0.1",
    "discord.js": "^14.27.0",
    "i18next": "^26.5.11",
    "i18next-fs-backend": "^2.6.9",
    "mongoose": "^8",
    "ms": "^2.1.3",
    "node-os-utils": "^1.3.7",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10",
    "@types/bun": "^1.4.4",
    "@types/ms": "^0.7.34",
    "@types/node-os-utils": "^1.3.4",
    "@types/react": "^18.3.23",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3"
  },
  "bugs": {
    "url": "https://github.com/CuteNikki/discord-bot/issues"
  },
  "description": "DiscordJS Bot written in TypeScript",
  "homepage": "https://github.com/CuteNikki/discord-bot",
  "license": "MIT",
  "scripts": {
    "dev": "bun run ./src/index.ts",
    "deploy": "bun run ./src/structure/utilities/register.ts",
    "start": "bun run ./dist/src/index.js",
    "build": "rm -rf dist && bun tsc --build ./",
    "pretty": "prettier --write \"./**/*.{js,jsx,mjs,cjs,ts,tsx,json}\"",
    "lint": "eslint --ignore-pattern \"locales/*\"",
    "dellog": "rm pino.log"
  },
  "prettier": {
    "printWidth": 160,
    "singleQuote": true,
    "jsxSingleQuote": true,
    "trailingComma": "none"
  },
  "type": "module"
}
